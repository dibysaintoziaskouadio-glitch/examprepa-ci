# Copier en .env.prod (jamais commité) puis remplir.
DOMAIN=examprepa.ci
POSTGRES_PASSWORD=change-moi
JWT_SECRET=change-moi-avec-au-moins-32-caracteres-aleatoires

# SMS (OTP) : brancher un agrégateur dans server/src/common/sms.service.ts
OTP_DEV_RETURN=false

# Premier démarrage : seed sans comptes de démonstration
SEED_DEMO=false
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=mot-de-passe-admin-tres-long

# Paiements (sans ces variables : mode simulation)
PAYWALL_ENABLED=true
PAYMENT_PROVIDER=cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Notifications push : générer avec `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@examprepa.ci

# Connexion Google (console Google Cloud, identifiant client OAuth « Application Web »)
GOOGLE_CLIENT_ID=

# Assistant IA (plan de révision, aide à la correction). Vide : désactivé.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
